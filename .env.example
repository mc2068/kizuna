# Copy to .env.local. Leave the Supabase lines out to run on the in-memory fake (no database).
# Local values: `pnpm db:start`, then `pnpm exec supabase status` prints them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC_: bypasses row-level security (used to insert study requests).
SUPABASE_SERVICE_ROLE_KEY=

# Fake store only. Production builds refuse to run on it unless ALLOW_FAKE_DB=1 (demo builds, e2e).
# ALLOW_FAKE_DB=1
# Who is signed in at start (admin | user | none).
# FAKE_DB_USER=admin

# Email (Resend). Unset RESEND_API_KEY = study request emails are skipped and logged as "skipped" in the
# lead's History. EMAIL_FROM must use a domain verified in Resend ("[PRODUCT NAME] <hello@your-domain>").
# TEAM_NOTIFY_EMAIL: comma-separated addresses that get every new study request.
RESEND_API_KEY=
EMAIL_FROM=
TEAM_NOTIFY_EMAIL=

# Absolute links in emails (admin lead link, privacy notice). Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain

# e2e only: the local Mailpit inbox the Playwright sign-in test reads (`supabase status` prints it).
# MAILPIT_URL=http://127.0.0.1:54324

# Where each value lives on Vercel (Settings, Environment Variables):
# - Production: the NEXT_PUBLIC_SUPABASE_* and SUPABASE_SERVICE_ROLE_KEY lines come from the Supabase
#   integration; add RESEND_API_KEY, EMAIL_FROM, TEAM_NOTIFY_EMAIL and NEXT_PUBLIC_SITE_URL by hand.
# - Preview: no database is connected, so set ALLOW_FAKE_DB=1 there and previews run on the demo data.
# Vercel Analytics needs no variable: enable it in the Vercel project (Analytics tab).
