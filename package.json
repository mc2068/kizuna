{
  "name": "kizuna-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "SUPABASE_TESTS=1 vitest run tests --no-file-parallelism",
    "test:watch": "vitest",
    "test:engine-reference": "node --test engine/*.test.mjs",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset && tsx scripts/seed-storage.mts",
    "db:seed": "tsx scripts/seed-sql.mts",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/types.ts && oxfmt src/lib/supabase/types.ts"
  },
  "dependencies": {
    "@react-email/render": "2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.6",
    "resend": "6.37.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "oxfmt": "^0.79.0",
    "pg": "^8.23.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.28.0"
}
