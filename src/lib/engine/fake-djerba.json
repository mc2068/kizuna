  "assumptions": [
    {
      "name": "Natural gas price (per kWh LHV, before VAT)",
      "unfavourable": 0.09,
      "central": 0.068,
      "favourable": 0.068,
      "unit": "TND/kWh",
      "source": "STEG MP1 71.1 + 0.25 FTE mill/thermie (in force since 1 May 2022, via FIPA Jan 2024 https://investintunisia.tn/wp-content/uploads/2024/01/Couts-des-facteurs-FIPA-Janvier-2024.pdf) = 0.061 TND/kWh HHV = 0.068 LHV. Unfavourable: +32% for a subsidy reform (ESTIMATE)"
    },
    {
      "name": "Engine electrical efficiency (LHV)",
      "unfavourable": 0.35,
      "central": 0.38,
      "favourable": 0.4,
      "unit": "fraction",
      "source": "DOE CHP reciprocating engines fact sheet: 27.7% (35 kW) to 40.6% (4.5 MW) HHV; 400-600 kWe class ~35-40% LHV https://betterbuildingssolutioncenter.energy.gov/sites/default/files/attachments/CHP_Reciprocating_Engines.pdf (ESTIMATE within range)"
    },
    {
      "name": "Engine useful heat recovery efficiency (LHV, hot water ~90 °C)",
      "unfavourable": 0.42,
      "central": 0.43,
      "favourable": 0.45,
      "unit": "fraction",
      "source": "Chosen so total efficiency is 0.77-0.85, the 75-85% range in DOE https://betterbuildingssolutioncenter.energy.gov/sites/default/files/attachments/CHP_Reciprocating_Engines.pdf and docs research §1. v1 used 1.67 kWth/kWe (total 0.96), physically too high"
    },
    {
      "name": "Installed engine plant cost at 500 kWe (incl. balance of plant, gas and grid connection)",
      "unfavourable": 9100,
      "central": 7000,
      "favourable": 5000,
      "unit": "TND/kWe",
      "source": "DOE installed cost $3,150/kW at 500 kW (2020 USD) x 2.89 TND/USD = 9,100 (unfavourable, US labour). Central and favourable assume lower Tunisian installation cost: ESTIMATE until an installer quote. v1 used 2,000 (fleet average of mostly multi-MW plants)"
    },
    {
      "name": "Engine cost scaling with size, (kWe / 500) ^ exponent",
      "unfavourable": -0.12,
      "central": -0.12,
      "favourable": -0.12,
      "unit": "-",
      "source": "Fitted to the DOE curve: $3,700/kW at 100 kW, $3,150 at 500 kW, $2,800 at 1 MW https://betterbuildingssolutioncenter.energy.gov/sites/default/files/attachments/CHP_Reciprocating_Engines.pdf"
    },
    {
      "name": "Absorption chiller installed cost, with cooling tower",
      "unfavourable": 4500,
      "central": 3000,
      "favourable": 2000,
      "unit": "TND/kWc",
      "source": "DOE single-effect $1,800-6,000 per RT = 1,480-4,930 TND/kWc, higher for small units https://www.energy.gov/sites/default/files/2017/06/f35/CHP-Absorption%20Chiller-compliant.pdf. ESTIMATE within range"
    },
    {
      "name": "Engine maintenance including overhauls",
      "unfavourable": 0.058,
      "central": 0.04,
      "favourable": 0.03,
      "unit": "TND/kWh produced",
      "source": "DOE non-fuel O&M 2.0 US cents/kWh at 500 kW = 0.058 TND (unfavourable) https://betterbuildingssolutioncenter.energy.gov/sites/default/files/attachments/CHP_Reciprocating_Engines.pdf; lower Tunisian labour cost for central/favourable is an ESTIMATE"
    },
    {
